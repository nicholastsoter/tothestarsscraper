GOOGLE_PLACES_API_KEY=your_google_places_api_key
WEBAPP_USER=your_chosen_username
WEBAPP_PASSWORD=your_chosen_password
RATE_LIMIT_PER_HOUR=20

# Optional — only needed to use Postgres instead of the local SQLite file.
# On Vercel this is set automatically by the Postgres/Neon storage
# integration; leave unset for local dev.
# POSTGRES_URL=postgresql://user:password@host/dbname
